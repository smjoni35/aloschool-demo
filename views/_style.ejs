<div class="app-confirm-overlay" id="appConfirmOverlay">
  <div class="app-confirm-box">
    <div class="app-confirm-icon">⚠️</div>
    <div class="app-confirm-msg" id="appConfirmMsg"></div>
    <div class="app-confirm-actions">
      <button type="button" class="app-confirm-cancel" id="appConfirmCancel">বাতিল</button>
      <button type="button" class="app-confirm-ok" id="appConfirmOk">নিশ্চিত</button>
    </div>
  </div>
</div>
<script>
  // Used in place of onsubmit="return confirm('...')" on destructive forms:
  // onsubmit="return appConfirm(this, '...')". Shows the styled modal above
  // instead of the browser's native confirm() popup; on "নিশ্চিত" it submits
  // the real form (bypassing this same handler so it doesn't loop back
  // through the modal), on "বাতিল" or overlay-click it does nothing.
  function appConfirm(form, message) {
    var overlay = document.getElementById("appConfirmOverlay");
    var msgEl = document.getElementById("appConfirmMsg");
    var okBtn = document.getElementById("appConfirmOk");
    var cancelBtn = document.getElementById("appConfirmCancel");
    if (!overlay || !msgEl || !okBtn || !cancelBtn) return confirm(message); // fallback
    msgEl.textContent = message;
    overlay.classList.add("open");
    function close() {
      overlay.classList.remove("open");
      okBtn.removeEventListener("click", onOk);
      cancelBtn.removeEventListener("click", onCancel);
      overlay.removeEventListener("click", onOverlay);
    }
    function onOk() {
      close();
      HTMLFormElement.prototype.submit.call(form);
    }
    function onCancel() { close(); }
    function onOverlay(e) { if (e.target === overlay) close(); }
    okBtn.addEventListener("click", onOk);
    cancelBtn.addEventListener("click", onCancel);
    overlay.addEventListener("click", onOverlay);
    return false;
  }
</script>

<!--
  Bangla-digit guard for English-only number fields (session/year, roll,
  mobile numbers, result-lookup code, founded year). This lives here
  (rather than in _script.ejs) because _style.ejs is the one partial every
  real page already includes, so the guard applies everywhere automatically
  without touching each view. It does NOT affect <input type="number">
  fields (marks, fees amounts) — browsers already reject non-ASCII digits
  in those natively.
-->
<script>
(function () {
  var EN_DIGIT_FIELD_NAMES = [
    "session", "roll", "phone", "fatherPhone", "motherPhone", "contactPhone",
    "emergencyPhone", "code", "foundedYear"
  ];
  var BN_DIGIT_RE = /[০-৯]/;
  var BN_DIGIT_RE_G = /[০-৯]/g;

  function isGuardedField(el) {
    if (!el || el.tagName !== "INPUT") return false;
    if (el.type === "tel") return true;
    return EN_DIGIT_FIELD_NAMES.indexOf(el.name) !== -1;
  }

  function showWarning(el) {
    var warn = el._bnDigitWarn;
    if (!warn) {
      warn = document.createElement("div");
      warn.textContent = "এই ঘরে বাংলা সংখ্যা লেখা যাবে না — ইংরেজি সংখ্যা (0-9) লিখুন";
      warn.style.cssText = "color:#dc2626;font-size:12px;margin:2px 0 8px;";
      el.insertAdjacentElement("afterend", warn);
      el._bnDigitWarn = warn;
    }
    clearTimeout(el._bnDigitWarnTimer);
    el._bnDigitWarnTimer = setTimeout(function () {
      if (warn && warn.parentNode) warn.parentNode.removeChild(warn);
      el._bnDigitWarn = null;
    }, 3000);
  }

  document.addEventListener("input", function (e) {
    var el = e.target;
    if (!isGuardedField(el) || !BN_DIGIT_RE.test(el.value)) return;
    var pos = el.selectionStart;
    var before = el.value;
    el.value = before.replace(BN_DIGIT_RE_G, "");
    var removed = before.length - el.value.length;
    try { el.setSelectionRange(pos - removed, pos - removed); } catch (err) {}
    showWarning(el);
  });
})();
</script>
<script>
  // Remembers which collapsible cards (details.acc) were opened/closed, so a
  // form submit that reloads the page doesn't fold everything back up.
  // Kept per browser tab (sessionStorage) — a fresh visit starts from the
  // defaults set in the page itself. A card marked data-force-open (it holds
  // a result/error message, or only exists because the user asked for it)
  // is always shown open and never overridden by a remembered "closed".
  document.addEventListener('DOMContentLoaded', function () {
    var store;
    try { store = window.sessionStorage; } catch (e) { return; }
    document.querySelectorAll('details.acc').forEach(function (d) {
      if (d.hasAttribute('data-force-open')) { d.open = true; return; }
      var s = d.querySelector('summary');
      if (!s) return;
      // drop any "(…)" suffix (counts, session) so the key stays stable
      var label = s.textContent.replace(/\s*[(（][\s\S]*$/, '').replace(/\s+/g, ' ').trim();
      var key = 'acc:' + location.pathname + '|' + label;
      try {
        var v = store.getItem(key);
        if (v === '1') d.open = true;
        else if (v === '0') d.open = false;
      } catch (e) {}
      d.addEventListener('toggle', function () {
        try { store.setItem(key, d.open ? '1' : '0'); } catch (e) {}
      });
    });
  });
</script>
