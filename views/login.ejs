<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>লগইন — <%= settings.schoolName || 'স্কুল ম্যানেজমেন্ট সিস্টেম' %></title>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet">
<%- include('_style') %>
<%- include('_pwa') %>
<%- include('_motion') %>
</head>
<body class="page-auth">
  <div class="card" style="max-width: 380px; margin-top: 60px;">
    <div class="brand-header" style="margin-bottom:16px;">
      <% if (settings.logoDataUrl) { %>
        <img class="brand-logo" src="<%= settings.logoDataUrl %>" alt="লোগো" />
      <% } %>
      <div>
        <h1 style="margin:0; font-size:17px;"><%= settings.schoolName || 'স্কুল ম্যানেজমেন্ট সিস্টেম' %></h1>
        <p class="sub" style="margin:2px 0 0;">🔒 এডমিন লগইন</p>
      </div>
    </div>
    <p class="sub">স্কুল ম্যানেজমেন্ট সিস্টেম ব্যবহার করতে এডমিন পাসওয়ার্ড দিন</p>
    <% if (typeof demoMode !== 'undefined' && demoMode) { %>
      <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px; padding:10px 12px; margin-bottom:14px; font-size:13px; color:#1e3a8a;">
        🧪 এটি একটি <strong>ডেমো সাইট</strong> — সব ফিচার দেখতে নিচের তথ্য দিয়ে লগইন করুন:<br />
        পাসওয়ার্ড: <strong><%= demoAdminPassword %></strong>
      </div>
    <% } %>
    <% if (error) { %>
      <p style="color:#b91c1c; font-size:14px; margin:0 0 12px;"><%= error %></p>
    <% } %>
    <form method="POST" action="/login">
      <label>পাসওয়ার্ড</label>
      <input type="password" name="password" required autofocus />
      <button type="submit" class="btn btn-primary btn-block">প্রবেশ করুন</button>
    </form>
    <p style="font-size:12px; color:#999; margin:14px 0 0; text-align:center;">
      শিক্ষক? <a href="/teacher/login">এখানে লগইন করুন</a>
    </p>
  </div>
</body>
</html>
