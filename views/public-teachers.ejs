<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>শিক্ষক / স্টাফ — <%= settings.schoolName || 'স্কুল' %></title>
<meta name="description" content="<%= (settings.schoolName || 'স্কুল') %>-এর শিক্ষক ও স্টাফদের তালিকা" />
<link rel="icon" type="image/png" href="/icon-192.png" />
<link rel="apple-touch-icon" href="/icon-192.png" />
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet">
<%- include('_style') %>
<%- include('_pwa') %>
<%- include('_motion') %>
<%- include('_public-style') %>
<style>
  body { padding: 0; }
  .page-header {
    background: linear-gradient(135deg, #2563eb 0%, #1e3a8a 100%);
    padding: 32px 18px 40px; text-align: center; border-radius: 0 0 28px 28px; margin-bottom: 0;
  }
  .page-header h1 { color: #fff; font-size: 22px; margin: 0 0 6px; }
  .page-header p { color: rgba(255,255,255,0.88); font-size: 13.5px; margin: 0; }
  .page-content { max-width: 1100px; margin: 0 auto; padding: 20px 16px 0; }
  @media (min-width: 900px) {
    body.public-home:not(.page-dashboard) { padding: 0; }
    body.public-home .page-content .card { max-width: none; }
    .page-header { padding: 48px 24px 56px; }
    .page-header h1 { font-size: 30px; }
    .page-header p { font-size: 15px; }
    .teacher-grid { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px; }
    .teacher-card { padding: 24px 10px 20px; }
    .teacher-card img, .teacher-card .avatar-fallback { width: 104px; height: 104px; }
    .teacher-card .avatar-fallback { font-size: 42px; }
    .teacher-card .name { font-size: 16px; }
    .teacher-card .designation { font-size: 13px; }
  }
</style>
</head>
<body class="public-home">

  <%- include('_public-nav', { activePage: 'teachers' }) %>

  <div class="page-header">
    <h1>শিক্ষক / স্টাফ</h1>
    <p><%= settings.schoolName || 'স্কুল' %>-এর শিক্ষক ও স্টাফ</p>
  </div>

  <div class="page-content">

  <% if (teachers.length === 0) { %>
  <div class="card"><p class="empty">এখনো কোনো শিক্ষক/স্টাফ যোগ করা হয়নি।</p></div>
  <% } else { %>
  <div class="card">
    <div class="teacher-grid">
      <% teachers.forEach((t) => { %>
        <div class="teacher-card">
          <% if (t.photoDataUrl) { %>
            <img src="<%= t.photoDataUrl %>" alt="<%= t.name %>" />
          <% } else {
               const skip = /^(মো|মোঃ|মোছা|মোছাঃ|মোসা|মোসাঃ|মোসাম্মৎ|মোছাম্মৎ|মোছাম্মাৎ|মিস|মিসেস|Md|Mst|Mr|Mrs|Ms)[.ঃ:]*$/i;
               const parts = String(t.name || '').trim().split(/\s+/).filter(Boolean);
               const real = parts.find((w) => !skip.test(w)) || parts[0] || '?';
               const initial = Array.from(real)[0].toUpperCase();
               const colors = ['#2563eb','#7c3aed','#db2777','#ea580c','#059669','#0891b2','#c026d3','#65a30d'];
               let h = 0; for (const ch of String(t.name || '')) h = (h * 31 + ch.codePointAt(0)) >>> 0;
               const c1 = colors[h % colors.length];
               const c2 = colors[(h + 3) % colors.length];
          %>
            <div class="avatar-fallback" style="background: linear-gradient(135deg, <%= c1 %>, <%= c2 %>);" aria-label="<%= t.name %>"><%= initial %></div>
          <% } %>
          <div class="name"><%= t.name %></div>
          <% if (t.designation) { %><div class="designation"><%= t.designation %></div><% } %>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <%- include('_public-footer') %>

  </div>

<button type="button" class="to-top" id="toTop" aria-label="উপরে যান" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</button>
<script>
  var toTop = document.getElementById('toTop');
  if (toTop) {
    var toggleTop = function () { toTop.classList.toggle('show', window.scrollY > 500); };
    window.addEventListener('scroll', toggleTop, { passive: true });
    toggleTop();
  }
</script>
<%- include('_floating-contact') %>
</body>
</html>
