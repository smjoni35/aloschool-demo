<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>আমাদের সম্পর্কে — <%= settings.schoolName || 'স্কুল' %></title>
<% const seoDesc = (website.about || website.tagline || (settings.schoolName ? settings.schoolName + ' সম্পর্কে জানুন' : 'স্কুল সম্পর্কে')).toString().replace(/\s+/g, ' ').trim().slice(0, 160); %>
<meta name="description" content="<%= seoDesc %>" />
<link rel="icon" type="image/png" href="/icon-192.png" />
<link rel="apple-touch-icon" href="/icon-192.png" />
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet">
<%- include('_style') %>
<%- include('_pwa') %>
<%- include('_motion') %>
<%- include('_public-style') %>
<style>
  body { padding: 0; }
  .page-content { padding: 0 16px; }
  .page-header {
    background: linear-gradient(135deg, #2563eb 0%, #1e3a8a 100%);
    padding: 32px 18px 40px; text-align: center; border-radius: 0 0 28px 28px; margin-bottom: 0;
  }
  .page-header h1 { color: #fff; font-size: 22px; margin: 0 0 6px; }
  .page-header p { color: rgba(255,255,255,0.88); font-size: 13.5px; margin: 0; }
  .page-content { max-width: 900px; margin: 0 auto; padding: 20px 16px 0; }
  .about-text { white-space: pre-line; color: #334155; font-size: 15px; line-height: 1.9; }
  @media (min-width: 900px) {
    body.public-home:not(.page-dashboard) { padding: 0; }
    body.public-home .page-content .card { max-width: none; }
    .page-header { padding: 48px 24px 56px; }
    .page-header h1 { font-size: 30px; }
    .page-header p { font-size: 15px; }
  }
</style>
</head>
<body class="public-home">

  <%- include('_public-nav', { activePage: 'about' }) %>

  <div class="page-header">
    <h1>আমাদের সম্পর্কে</h1>
    <% if (website.tagline) { %><p><%= website.tagline %></p><% } %>
  </div>

  <div class="page-content">

  <% if (website.about) { %>
  <div class="card">
    <h2><%= settings.schoolName || 'স্কুল' %> সম্পর্কে</h2>
    <div class="about-text"><%= website.about %></div>
  </div>
  <% } %>

  <% messageCards.forEach(function (m) { %>
  <div class="card head-card" id="<%= m.id %>">
    <h2><%= m.title %></h2>
    <div class="head-wrap">
      <div class="head-person">
        <% if (m.photo) { %>
          <img class="head-photo" src="<%= m.photo %>" alt="<%= m.name || m.fallbackAlt %>" />
        <% } else { %>
          <div class="head-avatar">👤</div>
        <% } %>
        <% if (m.name) { %><div class="head-name"><%= m.name %></div><% } %>
        <% if (m.desig) { %><div class="head-desig"><%= m.desig %></div><% } %>
      </div>
      <div class="head-text"><%= m.msg %></div>
    </div>
  </div>
  <% }); %>

  <%
    const missionLines = String(website.mission || '').split(/\r?\n/)
      .map(function (l) { return l.trim().replace(/^[-•*·]\s*/, ''); })
      .filter(Boolean);
  %>
  <% if (website.vision || missionLines.length > 0) { %>
  <div class="card vm-card" id="vision-mission">
    <h2>ভিশন ও মিশন</h2>
    <div class="vm-grid">
      <% if (website.vision) { %>
      <div class="vm-box vm-vision">
        <div class="vm-icon">🎯</div>
        <h3>আমাদের ভিশন</h3>
        <p><%= website.vision %></p>
      </div>
      <% } %>
      <% if (missionLines.length > 0) { %>
      <div class="vm-box vm-mission">
        <div class="vm-icon">🚀</div>
        <h3>আমাদের মিশন</h3>
        <ul>
          <% missionLines.forEach(function (l) { %><li><%= l %></li><% }); %>
        </ul>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <% if (!website.about && messageCards.length === 0 && !website.vision && missionLines.length === 0) { %>
  <div class="card"><p class="empty">এই অংশ এখনো সাজানো হয়নি।</p></div>
  <% } %>

  <%- include('_public-footer') %>

  </div>

<button type="button" class="to-top" id="toTop" aria-label="উপরে যান" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</button>
<script>
  var toTop = document.getElementById('toTop');
  if (toTop) {
    var toggleTop = function () { toTop.classList.toggle('show', window.scrollY > 500); };
    window.addEventListener('scroll', toggleTop, { passive: true });
    toggleTop();
  }
</script>
<%- include('_floating-contact') %>
</body>
</html>
