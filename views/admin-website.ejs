<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>স্কুল ওয়েবসাইট ম্যানেজ — স্কুল ম্যানেজমেন্ট সিস্টেম</title>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet">
<%- include('_style') %>
<%- include('_pwa') %>
</head>
<body>
  <div class="app-shell">
    <%- include('_sidebar') %>
    <div class="main-content">

  <div class="nav">
    <a href="/panel">🏠 হোম</a>
    <a href="/" target="_blank">🌐 ওয়েবসাইট দেখুন</a>
    <a href="/logout">🚪 লগআউট</a>
  </div>

  <div class="card">
    <h1>🌐 স্কুল ওয়েবসাইট</h1>
    <p class="sub">এখানে যা কিছু সংরক্ষণ করবেন, তা সরাসরি পাবলিক ওয়েবসাইটে (<a href="/" target="_blank">হোমপেজে</a>) দেখাবে — লগইন ছাড়াই সবাই দেখতে পারবে।</p>
    <p style="font-size:13px; color:#666; margin:0;">📊 বর্তমানে সিস্টেমে মোট <strong><%= totalStudents %></strong> জন শিক্ষার্থী ও <strong><%= teachers.length %></strong> জন শিক্ষক আছেন — এই সংখ্যাগুলো "কেন আমাদের স্কুল" স্ট্যাটসে স্বয়ংক্রিয়ভাবে দেখাবে (সব ক্লাস মিলিয়ে সর্বমোট)।</p>
  </div>

  <details class="card acc">
    <summary>পরিচিতি ও ভর্তি তথ্য</summary>
    <form method="POST" action="/admin/website/info">
      <label>ছোট স্লোগান / ট্যাগলাইন (ঐচ্ছিক — হোমপেজের ব্যানারে স্কুলের নামের নিচে দেখাবে)</label>
      <input type="text" name="tagline" maxlength="120" value="<%= website.tagline || '' %>" placeholder="যেমন: দ্বীনি ও আধুনিক শিক্ষার সমন্বিত প্রতিষ্ঠান" />

      <label>স্কুল পরিচিতি (হোমপেজের "আমাদের সম্পর্কে" অংশে দেখাবে)</label>
      <textarea name="about" rows="4" placeholder="স্কুল সম্পর্কে সংক্ষিপ্ত পরিচিতি লিখুন..."><%= website.about || '' %></textarea>

      <label>প্রতিষ্ঠার সাল (ঐচ্ছিক — "কেন আমাদের স্কুল" স্ট্যাটসে দেখাবে)</label>
      <input type="text" name="foundedYear" value="<%= website.foundedYear || '' %>" placeholder="যেমন: ২০১০" />

      <label>ভর্তি তথ্য</label>
      <textarea name="admission" rows="4" placeholder="ভর্তির নিয়ম, ক্লাস, বয়সসীমা, ফি ইত্যাদি লিখুন..."><%= website.admission || '' %></textarea>

      <label class="check-row">
        <input type="checkbox" name="admissionBannerEnabled" <%= website.admissionBannerEnabled ? 'checked' : '' %> />
        হোমপেজে ভর্তির ঘোষণা ব্যানার দেখান
      </label>
      <input type="text" name="admissionBannerText" maxlength="150" value="<%= website.admissionBannerText || '' %>" placeholder="যেমন: ২০২৭ সেশনের ভর্তি চলছে, শেষ তারিখ ৩১ ডিসেম্বর" />
      <p style="color:#999; font-size:12px; margin:-4px 0 0;">উপরের বক্সে টিক দিলে এবং লেখা থাকলে হোমপেজের একদম উপরে (মেনুর নিচে) এই ব্যানারটি দেখাবে।</p>

      <label>ঠিকানা</label>
      <input type="text" name="contactAddress" value="<%= website.contactAddress || '' %>" placeholder="স্কুলের ঠিকানা" />

      <div class="row">
        <div>
          <label>ফোন নম্বর</label>
          <input type="text" name="contactPhone" value="<%= website.contactPhone || '' %>" placeholder="01xxxxxxxxx" />
        </div>
        <div>
          <label>ইমেইল</label>
          <input type="text" name="contactEmail" value="<%= website.contactEmail || '' %>" placeholder="school@example.com" />
        </div>
      </div>
      <p style="color:#999; font-size:12px; margin:-4px 0 0;">এই ফোন নম্বরেই ওয়েবসাইটে "হোয়াটসঅ্যাপে মেসেজ করুন" বাটন কাজ করবে।</p>

      <label>গুগল ম্যাপ Embed লিংক (ঐচ্ছিক)</label>
      <input type="text" name="mapEmbedUrl" value="<%= website.mapEmbedUrl || '' %>" placeholder="Google Maps থেকে Embed URL কপি করে বসান" />

      <label>Facebook পেজ লিংক (ঐচ্ছিক)</label>
      <input type="text" name="facebookUrl" value="<%= website.facebookUrl || '' %>" placeholder="https://facebook.com/yourschool" />

      <label>YouTube চ্যানেল লিংক (ঐচ্ছিক)</label>
      <input type="text" name="youtubeUrl" value="<%= website.youtubeUrl || '' %>" placeholder="https://youtube.com/@yourschool" />

      <button type="submit" class="btn btn-primary btn-block">সংরক্ষণ করুন</button>
    </form>
  </details>

  <% [
    { key: 'director', Key: 'Director', title: '👔 পরিচালকের বাণী', who: 'পরিচালক', desigHint: 'যেমন: পরিচালক / প্রতিষ্ঠাতা পরিচালক' },
    { key: 'head', Key: 'Head', title: '👤 প্রধান শিক্ষকের বাণী', who: 'প্রধান শিক্ষক', desigHint: 'যেমন: প্রধান শিক্ষক' }
  ].forEach(function (m) {
    const auto = (typeof rolePeople !== 'undefined' && rolePeople[m.key]) || null;
    const nameVal = website[m.key + 'Name'] || '';
    const desigVal = website[m.key + 'Designation'] || '';
    const msgVal = website[m.key + 'Message'] || '';
    const photoVal = website[m.key + 'PhotoDataUrl'] || '';
  %>
  <details class="card acc">
    <summary><%= m.title %></summary>
    <form method="POST" action="/admin/website/<%= m.key %>" id="<%= m.key %>Form">
      <% if (auto) { %>
        <div style="display:flex; align-items:center; gap:10px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:12px; padding:10px 12px; margin-bottom:10px;">
          <% if (auto.photoDataUrl) { %>
            <img src="<%= auto.photoDataUrl %>" alt="" style="width:44px; height:44px; object-fit:cover; border-radius:50%; flex-shrink:0;" />
          <% } %>
          <div style="font-size:13px; line-height:1.5;">
            ✔ শিক্ষক / স্টাফ তালিকা থেকে স্বয়ংক্রিয়ভাবে নেওয়া হচ্ছে:<br />
            <strong><%= auto.name %></strong> — <%= auto.designation %>
          </div>
        </div>
        <p style="color:#999; font-size:12px; margin:0 0 8px;">নাম, পদবি বা ছবি বদলাতে "🏫 শিক্ষক / স্টাফ" তালিকা থেকে ঠিক করুন — এখানে শুধু বাণী লিখলেই হবে।</p>
      <% } else { %>
        <p style="color:#666; font-size:12.5px; margin:0 0 10px; line-height:1.5;">💡 "🏫 শিক্ষক / স্টাফ" তালিকায় পদবি <strong>"<%= m.who %>"</strong> দিয়ে কাউকে যোগ করলে তার নাম, পদবি ও ছবি নিজে থেকেই এখানে আসবে। তালিকায় না রাখতে চাইলে নিচে হাতে দিন।</p>

        <label>নাম</label>
        <input type="text" name="<%= m.key %>Name" maxlength="80" value="<%= nameVal %>" placeholder="<%= m.who %>ের নাম" />

        <label>পদবি (ঐচ্ছিক)</label>
        <input type="text" name="<%= m.key %>Designation" maxlength="80" value="<%= desigVal %>" placeholder="<%= m.desigHint %>" />

        <label>ছবি (ঐচ্ছিক)</label>
        <% if (photoVal) { %>
          <img src="<%= photoVal %>" alt="<%= m.who %>" style="width:72px; height:72px; object-fit:cover; border-radius:50%; display:block; margin-bottom:8px;" />
        <% } %>
        <input type="file" id="<%= m.key %>PhotoFile" accept="image/*" />
        <input type="hidden" name="<%= m.key %>PhotoDataUrl" id="<%= m.key %>PhotoDataUrl" />
        <% if (photoVal) { %>
          <label class="check-row"><input type="checkbox" name="remove<%= m.Key %>Photo" /> বর্তমান ছবিটি মুছে ফেলুন</label>
        <% } %>
        <p id="<%= m.key %>PhotoStatus" style="color:#999; font-size:12px; margin:4px 0 8px;"></p>
      <% } %>

      <label>বাণী (হোমপেজে দেখাবে — ফাঁকা রাখলে কার্ডটি দেখাবে না)</label>
      <textarea name="<%= m.key %>Message" rows="6" maxlength="2000" placeholder="অভিভাবক ও শিক্ষার্থীদের উদ্দেশে কয়েক লাইন লিখুন..."><%= msgVal %></textarea>

      <button type="submit" class="btn btn-primary btn-block" id="<%= m.key %>SaveBtn">সংরক্ষণ করুন</button>
    </form>
    <% if (!auto) { %>
    <script>
      (function () {
        const fileInput = document.getElementById('<%= m.key %>PhotoFile');
        const hidden = document.getElementById('<%= m.key %>PhotoDataUrl');
        const status = document.getElementById('<%= m.key %>PhotoStatus');
        const saveBtn = document.getElementById('<%= m.key %>SaveBtn');

        // Fallback when cloud storage isn't set up: shrink to a small JPEG so the
        // saved data stays light.
        function shrinkToDataUrl(file) {
          return new Promise(function (resolve, reject) {
            const img = new Image();
            const objUrl = URL.createObjectURL(file);
            img.onload = function () {
              const max = 480;
              const scale = Math.min(1, max / Math.max(img.width, img.height));
              const canvas = document.createElement('canvas');
              canvas.width = Math.round(img.width * scale);
              canvas.height = Math.round(img.height * scale);
              canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
              URL.revokeObjectURL(objUrl);
              resolve(canvas.toDataURL('image/jpeg', 0.85));
            };
            img.onerror = function () { URL.revokeObjectURL(objUrl); reject(new Error('bad image')); };
            img.src = objUrl;
          });
        }

        fileInput.addEventListener('change', async function () {
          const file = fileInput.files[0];
          hidden.value = '';
          if (!file) return;
          saveBtn.disabled = true;
          status.textContent = 'ছবি প্রস্তুত হচ্ছে...';
          try {
            try {
              const fd = new FormData();
              fd.append('photo', file);
              const resp = await fetch('/api/upload-photo?folder=teachers', { method: 'POST', body: fd });
              const data = await resp.json();
              if (data.url) { hidden.value = data.url; }
            } catch (e) { /* use the fallback below */ }
            if (!hidden.value) hidden.value = await shrinkToDataUrl(file);
            status.textContent = '✔ ছবি প্রস্তুত — এবার সংরক্ষণ করুন।';
          } catch (e) {
            status.textContent = 'ছবিটি পড়া যায়নি, অন্য ছবি বেছে নিন।';
          }
          saveBtn.disabled = false;
        });
      })();
    </script>
    <% } %>
  </details>
  <% }); %>

  <details class="card acc">
    <summary>🎯 ভিশন ও মিশন</summary>
    <form method="POST" action="/admin/website/vision">
      <label>ভিশন (রূপকল্প) — স্কুল ভবিষ্যতে কী হতে চায়</label>
      <textarea name="vision" rows="3" maxlength="400" placeholder="যেমন: দ্বীনি ও আধুনিক শিক্ষার সমন্বয়ে একটি আদর্শ শিক্ষাপ্রতিষ্ঠান হিসেবে গড়ে ওঠা।"><%= website.vision || '' %></textarea>

      <label>মিশন (অভীষ্ট) — প্রতি লাইনে একটি পয়েন্ট লিখুন</label>
      <textarea name="mission" rows="6" maxlength="1200" placeholder="প্রতিটি পয়েন্ট নতুন লাইনে লিখুন (Enter চাপুন)"><%= website.mission || '' %></textarea>
      <p style="color:#999; font-size:12px; margin:-4px 0 8px;">দুটোর যেকোনো একটি ফাঁকা রাখলে শুধু অন্যটি দেখাবে। দুটোই ফাঁকা থাকলে হোমপেজে এই কার্ড দেখাবে না।</p>

      <button type="submit" class="btn btn-primary btn-block">সংরক্ষণ করুন</button>
    </form>
  </details>

  <details class="card acc">
    <summary>💰 ফি-এর তথ্য</summary>
    <form method="POST" action="/admin/website/fees">
      <label class="check-row">
        <input type="checkbox" name="showFees" <%= website.showFees ? 'checked' : '' %> />
        হোমপেজে ফি-এর তথ্য দেখান
      </label>
      <p style="color:#999; font-size:12px; margin:-4px 0 10px; line-height:1.5;">অঙ্কগুলো নিজে থেকে বর্তমান শিক্ষাবর্ষের শ্রেণিভিত্তিক ফি কাঠামো (অ্যাডমিন → ফি) থেকে আসবে — ভর্তির সময়ের মোট ফি, সেশন ফি ও মাসিক বেতন। গাড়ি ভাড়া ও কোচিং বেতন হোমপেজে দেখানো হয় না। যে শ্রেণিতে কোনো ফি ঠিক করা নেই, সেটি দেখাবে না। ফি বদলালে হোমপেজেও নিজে থেকে বদলাবে।</p>

      <label>টেবিলের নিচের নোট (ঐচ্ছিক)</label>
      <textarea name="feesNote" rows="3" maxlength="400" placeholder="যেমন: দূরত্ব অনুযায়ী গাড়ি ভাড়া ভিন্ন হতে পারে। বিস্তারিত জানতে অফিসে যোগাযোগ করুন।"><%= website.feesNote || '' %></textarea>

      <button type="submit" class="btn btn-primary btn-block">সংরক্ষণ করুন</button>
    </form>
  </details>

  <details class="card acc">
    <summary>✨ সুযোগ-সুবিধা</summary>
    <p style="color:#666; font-size:12.5px; margin:0 0 10px; line-height:1.5;">স্কুলের সুবিধা বা অনলাইন সেবা — যা হোমপেজে তুলে ধরতে চান, একটা একটা করে যোগ করুন (সর্বোচ্চ ২৪টি)। কিছু যোগ না করলে হোমপেজে এই অংশ দেখাবে না।</p>
    <form method="POST" action="/admin/website/features/add">
      <div class="row">
        <div style="flex:0 0 90px;">
          <label>আইকন</label>
          <input type="text" name="icon" maxlength="8" placeholder="📚" style="text-align:center; font-size:20px;" />
        </div>
        <div>
          <label>শিরোনাম</label>
          <input type="text" name="title" maxlength="60" placeholder="যেমন: লাইব্রেরি" required />
        </div>
      </div>
      <label>ছোট বিবরণ (ঐচ্ছিক)</label>
      <input type="text" name="text" maxlength="200" placeholder="যেমন: শিক্ষার্থীদের জন্য সমৃদ্ধ পাঠাগার" />
      <p style="color:#999; font-size:12px; margin:-4px 0 8px;">আইকনে যেকোনো ইমোজি দিন (ফোনের কীবোর্ড থেকে)। ফাঁকা রাখলে ✅ বসবে।</p>
      <button type="submit" class="btn btn-primary btn-block">যোগ করুন</button>
    </form>

    <% if (features.length === 0) { %>
      <p class="empty">এখনো কিছু যোগ করা হয়নি।</p>
    <% } else { %>
      <% features.forEach((f) => { %>
        <div class="list-item" style="display:block;">
          <div style="display:flex; align-items:center; justify-content:space-between; gap:10px;">
            <div style="display:flex; align-items:center; gap:10px; min-width:0;">
              <span style="font-size:24px;"><%= f.icon || '✅' %></span>
              <div style="min-width:0;">
                <div><strong><%= f.title %></strong></div>
                <% if (f.text) { %><div style="color:#999; font-size:12px;"><%= f.text %></div><% } %>
              </div>
            </div>
            <form method="POST" action="/admin/website/features/<%= f.id %>/delete" onsubmit="return appConfirm(this, 'এই সুবিধাটি মুছে ফেলবেন?')">
              <button type="submit" class="btn btn-danger" style="padding:6px 10px; font-size:12px;">মুছুন</button>
            </form>
          </div>
          <details style="margin-top:8px;">
            <summary style="font-size:12.5px; color:#2563eb; cursor:pointer;">এডিট</summary>
            <form method="POST" action="/admin/website/features/<%= f.id %>/edit" style="margin-top:8px;">
              <div class="row">
                <div style="flex:0 0 90px;">
                  <label>আইকন</label>
                  <input type="text" name="icon" maxlength="8" value="<%= f.icon || '' %>" style="text-align:center; font-size:20px;" />
                </div>
                <div>
                  <label>শিরোনাম</label>
                  <input type="text" name="title" maxlength="60" value="<%= f.title %>" required />
                </div>
              </div>
              <label>ছোট বিবরণ</label>
              <input type="text" name="text" maxlength="200" value="<%= f.text || '' %>" />
              <button type="submit" class="btn btn-primary btn-block">সংরক্ষণ করুন</button>
            </form>
          </details>
        </div>
      <% }) %>
    <% } %>
  </details>

  <details class="card acc">
    <summary>📢 নোটিশ</summary>
    <form method="POST" action="/admin/website/notices/add">
      <label>শিরোনাম</label>
      <input type="text" name="title" placeholder="যেমন: গ্রীষ্মকালীন ছুটি সংক্রান্ত নোটিশ" required />
      <div class="row">
        <div>
          <label>তারিখ (ঐচ্ছিক)</label>
          <input type="date" name="date" />
        </div>
      </div>
      <label>বিস্তারিত (ঐচ্ছিক)</label>
      <textarea name="body" rows="3" placeholder="নোটিশের বিস্তারিত..."></textarea>
      <button type="submit" class="btn btn-primary btn-block">নোটিশ যোগ করুন</button>
    </form>

    <% if (notices.length === 0) { %>
      <p class="empty">এখনো কোনো নোটিশ যোগ করা হয়নি।</p>
    <% } else { %>
      <% notices.forEach((n) => { %>
        <div class="list-item">
          <div>
            <div><strong><%= n.title %></strong></div>
            <% if (n.date) { %><div style="color:#999; font-size:12px;"><%= n.date %></div><% } %>
          </div>
          <form method="POST" action="/admin/website/notices/<%= n.id %>/delete" onsubmit="return appConfirm(this, 'এই নোটিশটি মুছে ফেলবেন?')">
            <button type="submit" class="btn btn-danger" style="padding:6px 10px; font-size:12px;">মুছুন</button>
          </form>
        </div>
      <% }) %>
    <% } %>
  </details>

  <details class="card acc">
    <summary>🏫 শিক্ষক / স্টাফ</summary>
    <form method="POST" action="/admin/website/teachers/add" id="teacherForm">
      <label>নাম</label>
      <input type="text" name="name" placeholder="শিক্ষকের নাম" required />
      <label>পদবি (ঐচ্ছিক)</label>
      <input type="text" name="designation" placeholder="যেমন: প্রধান শিক্ষক" />
      <label>ছবি (ঐচ্ছিক)</label>
      <input type="file" id="teacherPhotoFile" accept="image/*" />
      <input type="hidden" name="photoDataUrl" id="teacherPhotoDataUrl" />
      <button type="submit" class="btn btn-primary btn-block">যোগ করুন</button>
    </form>

    <% if (teachers.length === 0) { %>
      <p class="empty">এখনো কোনো শিক্ষক যোগ করা হয়নি।</p>
    <% } else { %>
      <% teachers.forEach((t, i) => { %>
        <div class="list-item" id="view-teacher-<%= i %>">
          <div style="display:flex; align-items:center; gap:10px;">
            <% if (t.photoDataUrl) { %>
              <img src="<%= t.photoDataUrl %>" alt="<%= t.name %>" style="width:40px; height:40px; object-fit:cover; border-radius:50%;" />
            <% } %>
            <div>
              <div><strong><%= t.name %></strong></div>
              <% if (t.designation) { %><div style="color:#999; font-size:12px;"><%= t.designation %></div><% } %>
            </div>
          </div>
          <div style="display:flex; gap:6px;">
            <button type="button" class="btn btn-secondary" style="padding:6px 10px; font-size:12px;" onclick="toggleTeacherEdit(<%= i %>)">এডিট</button>
            <form method="POST" action="/admin/website/teachers/<%= t.id %>/delete" onsubmit="return appConfirm(this, 'এই এন্ট্রিটি মুছে ফেলবেন?')">
              <button type="submit" class="btn btn-danger" style="padding:6px 10px; font-size:12px;">মুছুন</button>
            </form>
          </div>
        </div>
        <div id="edit-teacher-<%= i %>" style="display:none; padding:10px 0; border-bottom:1px solid #f0f0f0;">
          <form method="POST" action="/admin/website/teachers/<%= t.id %>/edit" class="teacher-edit-form">
            <label>নাম</label>
            <input type="text" name="name" value="<%= t.name %>" required />
            <label>পদবি (ঐচ্ছিক)</label>
            <input type="text" name="designation" value="<%= t.designation || '' %>" />
            <label>নতুন ছবি (ঐচ্ছিক — না দিলে আগের ছবিই থাকবে)</label>
            <input type="file" class="teacher-edit-photo-file" accept="image/*" />
            <input type="hidden" name="photoDataUrl" class="teacher-edit-photo-hidden" />
            <div class="row" style="margin-top:10px;">
              <button type="submit" class="btn btn-primary" style="flex:1;">সেভ করুন</button>
              <button type="button" class="btn btn-secondary" style="flex:1;" onclick="toggleTeacherEdit(<%= i %>)">বাতিল</button>
            </div>
          </form>
        </div>
      <% }) %>
    <% } %>
    <script>
      async function uploadPhotoOrFallback(file, hiddenInput) {
        try {
          const fd = new FormData();
          fd.append('photo', file);
          const resp = await fetch('/api/upload-photo?folder=teachers', { method: 'POST', body: fd });
          const data = await resp.json();
          if (data.url) { hiddenInput.value = data.url; return; }
        } catch (e) { /* fall through to base64 fallback below */ }
        const reader = new FileReader();
        reader.onload = function () { hiddenInput.value = reader.result; };
        reader.readAsDataURL(file);
      }

      const teacherPhotoFile = document.getElementById('teacherPhotoFile');
      const teacherPhotoHidden = document.getElementById('teacherPhotoDataUrl');
      teacherPhotoFile.addEventListener('change', function () {
        const file = teacherPhotoFile.files[0];
        if (!file) return;
        uploadPhotoOrFallback(file, teacherPhotoHidden);
      });

      function toggleTeacherEdit(i) {
        const view = document.getElementById('view-teacher-' + i);
        const edit = document.getElementById('edit-teacher-' + i);
        const editing = edit.style.display !== 'none';
        edit.style.display = editing ? 'none' : 'block';
        view.style.display = editing ? 'flex' : 'none';
      }

      document.querySelectorAll('.teacher-edit-form').forEach(function (form) {
        const fileInput = form.querySelector('.teacher-edit-photo-file');
        const hiddenInput = form.querySelector('.teacher-edit-photo-hidden');
        fileInput.addEventListener('change', function () {
          const file = fileInput.files[0];
          if (!file) return;
          uploadPhotoOrFallback(file, hiddenInput);
        });
      });
    </script>
  </details>

  <details class="card acc">
    <summary>🖼 গ্যালারি</summary>
    <p class="sub" style="margin-bottom:8px;">ছবি ছোট সাইজে (কয়েক KB–কয়েকশো KB) আপলোড করুন — অনেকগুলো বড় ছবি জমা হলে সিস্টেম ধীর হয়ে যেতে পারে।</p>
    <form method="POST" action="/admin/website/gallery/add" id="galleryForm">
      <label>ছবি নির্বাচন করুন</label>
      <input type="file" id="galleryFile" accept="image/*" required />
      <input type="hidden" name="imageDataUrl" id="galleryDataUrl" />
      <label>ক্যাপশন (ঐচ্ছিক)</label>
      <input type="text" name="caption" placeholder="ছবির সংক্ষিপ্ত বিবরণ" />
      <button type="submit" class="btn btn-primary btn-block" id="galleryBtn" disabled>ছবি যোগ করুন</button>
    </form>

    <% if (gallery.length === 0) { %>
      <p class="empty">এখনো কোনো ছবি যোগ করা হয়নি।</p>
    <% } else { %>
      <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:8px; margin-top:14px;">
        <% gallery.forEach((g) => { %>
          <div style="position:relative;">
            <img src="<%= g.imageDataUrl %>" alt="<%= g.caption || '' %>" style="width:100%; height:80px; object-fit:cover; border-radius:8px;" />
            <form method="POST" action="/admin/website/gallery/<%= g.id %>/delete" onsubmit="return appConfirm(this, 'এই ছবিটি মুছে ফেলবেন?')" style="position:absolute; top:4px; right:4px;">
              <button type="submit" class="btn btn-danger" style="padding:2px 8px; font-size:11px;">✕</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>
    <script>
      const galleryFile = document.getElementById('galleryFile');
      const galleryHidden = document.getElementById('galleryDataUrl');
      const galleryBtn = document.getElementById('galleryBtn');
      galleryFile.addEventListener('change', async function () {
        const file = galleryFile.files[0];
        if (!file) { galleryBtn.disabled = true; return; }
        try {
          const fd = new FormData();
          fd.append('photo', file);
          const resp = await fetch('/api/upload-photo?folder=gallery', { method: 'POST', body: fd });
          const data = await resp.json();
          if (data.url) { galleryHidden.value = data.url; galleryBtn.disabled = false; return; }
        } catch (e) { /* fall through to base64 fallback below */ }
        const reader = new FileReader();
        reader.onload = function () {
          galleryHidden.value = reader.result;
          galleryBtn.disabled = false;
        };
        reader.readAsDataURL(file);
      });
    </script>
  </details>
  <%- include('_script') %>

    </div>
  </div>
</body>
</html>
