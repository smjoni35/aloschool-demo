<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>গ্যালারি — <%= settings.schoolName || 'স্কুল' %></title>
<meta name="description" content="<%= (settings.schoolName || 'স্কুল') %>-এর ছবির গ্যালারি" />
<link rel="icon" type="image/png" href="/icon-192.png" />
<link rel="apple-touch-icon" href="/icon-192.png" />
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet">
<%- include('_style') %>
<%- include('_pwa') %>
<%- include('_motion') %>
<%- include('_public-style') %>
<style>
  body { padding: 0; }
  .page-header {
    background: linear-gradient(135deg, #2563eb 0%, #1e3a8a 100%);
    padding: 32px 18px 40px; text-align: center; border-radius: 0 0 28px 28px; margin-bottom: 0;
  }
  .page-header h1 { color: #fff; font-size: 22px; margin: 0 0 6px; }
  .page-header p { color: rgba(255,255,255,0.88); font-size: 13.5px; margin: 0; }
  .page-content { max-width: 1100px; margin: 0 auto; padding: 20px 16px 0; }
  @media (min-width: 900px) {
    body.public-home:not(.page-dashboard) { padding: 0; }
    body.public-home .page-content .card { max-width: none; }
    .page-header { padding: 48px 24px 56px; }
    .page-header h1 { font-size: 30px; }
    .page-header p { font-size: 15px; }
    .gallery-grid { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; }
    .gallery-grid img { height: 190px; }
  }
</style>
</head>
<body class="public-home">

  <%- include('_public-nav', { activePage: 'gallery' }) %>

  <div class="page-header">
    <h1>গ্যালারি</h1>
    <p><%= settings.schoolName || 'স্কুল' %>-এর ছবি</p>
  </div>

  <div class="page-content">

  <% if (gallery.length === 0) { %>
  <div class="card"><p class="empty">এখনো কোনো ছবি যোগ করা হয়নি।</p></div>
  <% } else { %>
  <div class="card">
    <div class="gallery-grid">
      <% gallery.forEach((g) => { %>
        <img src="<%= g.imageDataUrl %>" alt="<%= g.caption || '' %>" onclick="openLightbox(this.src)" />
      <% }) %>
    </div>
  </div>
  <% } %>

  <%- include('_public-footer') %>

  </div>

  <% if (gallery.length > 0) { %>
  <div class="lightbox-overlay" id="lightboxOverlay" onclick="closeLightbox(event)">
    <button type="button" class="lightbox-close" onclick="closeLightbox(event)" aria-label="বন্ধ করুন">✕</button>
    <% if (gallery.length > 1) { %>
      <button type="button" class="lb-nav lb-prev" onclick="stepLightbox(-1)" aria-label="আগের ছবি">‹</button>
      <button type="button" class="lb-nav lb-next" onclick="stepLightbox(1)" aria-label="পরের ছবি">›</button>
      <div class="lb-count" id="lbCount"></div>
    <% } %>
    <img id="lightboxImg" src="" alt="" />
  </div>
  <script>
    var lbIndex = 0;
    function lbImages() { return Array.prototype.slice.call(document.querySelectorAll('.gallery-grid img')); }
    function lbShow(i, dir) {
      var imgs = lbImages();
      if (!imgs.length) return;
      lbIndex = (i + imgs.length) % imgs.length;
      var big = document.getElementById('lightboxImg');
      big.classList.remove('slide-next', 'slide-prev');
      void big.offsetWidth;
      big.src = imgs[lbIndex].src;
      if (dir) big.classList.add(dir > 0 ? 'slide-next' : 'slide-prev');
      var c = document.getElementById('lbCount');
      if (c) c.textContent = (lbIndex + 1) + ' / ' + imgs.length;
    }
    function openLightbox(src) {
      var imgs = lbImages();
      var idx = 0;
      for (var k = 0; k < imgs.length; k++) { if (imgs[k].src === src) { idx = k; break; } }
      lbShow(idx, 0);
      document.getElementById('lightboxOverlay').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function stepLightbox(d) { lbShow(lbIndex + d, d); }
    function closeLightbox(e) {
      if (e && e.target && (e.target.id === 'lightboxImg' || (e.target.closest && e.target.closest('.lb-nav')))) return;
      document.getElementById('lightboxOverlay').classList.remove('open');
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function (e) {
      if (!document.getElementById('lightboxOverlay').classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowRight') stepLightbox(1);
      else if (e.key === 'ArrowLeft') stepLightbox(-1);
    });
    (function () {
      var ov = document.getElementById('lightboxOverlay'), x0 = null;
      ov.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
      ov.addEventListener('touchend', function (e) {
        if (x0 === null) return;
        var dx = e.changedTouches[0].clientX - x0; x0 = null;
        if (Math.abs(dx) > 50) stepLightbox(dx < 0 ? 1 : -1);
      }, { passive: true });
    })();
  </script>
  <% } %>

<button type="button" class="to-top" id="toTop" aria-label="উপরে যান" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</button>
<script>
  var toTop = document.getElementById('toTop');
  if (toTop) {
    var toggleTop = function () { toTop.classList.toggle('show', window.scrollY > 500); };
    window.addEventListener('scroll', toggleTop, { passive: true });
    toggleTop();
  }
</script>
<%- include('_floating-contact') %>
</body>
</html>
