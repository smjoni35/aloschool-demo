<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= teacher.name %> — বেতন</title>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet">
<%- include('_style') %>
<%- include('_pwa') %>
<style>
  .fee-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f0f0f0; }
  .fee-row:last-child { border-bottom: none; }
  .fee-amt-charge { color: #b91c1c; font-weight: 600; }
  .fee-amt-payment { color: #15803d; font-weight: 600; }
  .fee-meta { font-size: 12px; color: #999; }
</style>
</head>
<body>
  <div class="nav">
    <a href="/panel">🏠 হোম</a>
    <a href="/admin/salary">← বেতন ম্যানেজমেন্ট</a>
    <a href="/logout">🚪 লগআউট</a>
  </div>

  <div class="card">
    <h1><%= teacher.name %> <% if (teacher.designation) { %><span class="pill"><%= teacher.designation %></span><% } %></h1>
    <p class="sub" style="margin:2px 0 12px;">নির্ধারিত মাসিক বেতন: ৳ <%= teacher.monthlySalary || 0 %> (বদলাতে <a href="/admin/salary">বেতন ম্যানেজমেন্ট পেজে</a> যান)</p>
    <div class="stat-grid">
      <div class="stat-card">
        <div class="num">৳ <%= balance.charged %></div>
        <div class="label">মোট বেতন ধার্য</div>
      </div>
      <div class="stat-card">
        <div class="num">৳ <%= balance.paid %></div>
        <div class="label">মোট উত্তোলন</div>
      </div>
      <div class="stat-card" style="grid-column: span 2;">
        <div class="num" style="color: <%= balance.due > 0 ? '#b91c1c' : (balance.due < 0 ? '#2563eb' : '#15803d') %>;">
          ৳ <%= Math.abs(balance.due) %>
        </div>
        <div class="label">
          <% if (balance.due > 0) { %>বকেয়া পাওনা (এখনো দেওয়া হয়নি)<% } else if (balance.due < 0) { %>অগ্রিম নেওয়া আছে<% } else { %>হিসাব সমান — কোনো বকেয়া নেই<% } %>
        </div>
      </div>
    </div>
    <% if (saved) { %>
      <p style="background:#f0fdf4; color:#15803d; padding:10px; border-radius:8px; font-size:14px; margin:14px 0 0;">✅ সংরক্ষণ করা হয়েছে।</p>
    <% } %>
  </div>

  <details class="card acc">
    <summary>টাকা উত্তোলন এন্ট্রি করুন</summary>
    <p class="sub" style="margin:0 0 10px;">পুরো বেতন, আংশিক, অথবা এখনো বেতন ধার্যই হয়নি এমন মাসের অগ্রিম — যেকোনো পরিমাণ, যতবার খুশি এন্ট্রি করা যাবে।</p>
    <form method="POST" action="/admin/salary/<%= teacher.id %>/withdrawal">
      <div class="row">
        <div>
          <label>টাকার পরিমাণ</label>
          <input type="number" name="amount" min="1" required />
        </div>
        <div>
          <label>ধরন</label>
          <select name="isAdvance">
            <option value="0">নিয়মিত বেতন উত্তোলন</option>
            <option value="1">অগ্রিম বেতন উত্তোলন</option>
          </select>
        </div>
      </div>
      <label>নোট (ঐচ্ছিক)</label>
      <input type="text" name="note" placeholder="যেমন: সেপ্টেম্বর মাসের অর্ধেক" />
      <button type="submit" class="btn btn-primary btn-block">✅ উত্তোলন এন্ট্রি করুন</button>
    </form>
  </details>

  <details class="card acc">
    <summary>অতিরিক্ত পাওনা যোগ করুন</summary>
    <p class="sub" style="margin:0 0 10px;">নিয়মিত বেতনের বাইরে কিছুর জন্য (যেমন ঈদ বোনাস, অতিরিক্ত ক্লাস) — একবারের পাওনা হিসেবে বসবে।</p>
    <form method="POST" action="/admin/salary/<%= teacher.id %>/charge">
      <div class="row">
        <div style="flex:2;">
          <input type="text" name="label" placeholder="যেমন: ঈদ বোনাস" required />
        </div>
        <div style="flex:1;">
          <input type="number" name="amount" placeholder="৳" min="1" required />
        </div>
      </div>
      <button type="submit" class="btn btn-secondary btn-block">যোগ করুন</button>
    </form>
  </details>

  <details class="card acc">
    <summary>হিস্টোরি</summary>
    <% if (ledger.length === 0) { %>
      <p class="empty">এখনো কোনো এন্ট্রি নেই।</p>
    <% } else { %>
      <% ledger.forEach(e => { %>
        <div class="fee-row">
          <div>
            <div><%= e.label %></div>
            <div class="fee-meta">
              <%= e.date %>
              <% if (e.note) { %> · <%= e.note %><% } %>
            </div>
          </div>
          <div style="display:flex; align-items:center; gap:10px;">
            <span class="<%= e.kind === 'payment' ? 'fee-amt-payment' : 'fee-amt-charge' %>">
              <%= e.kind === 'payment' ? '−' : '+' %>৳ <%= e.amount %>
            </span>
            <form method="POST" action="/admin/salary/<%= teacher.id %>/entry/<%= e.id %>/delete" onsubmit="return appConfirm(this, 'এই এন্ট্রিটা মুছে ফেলবেন?')">
              <button type="submit" class="btn btn-danger" style="padding:6px 10px; font-size:12px;">মুছুন</button>
            </form>
          </div>
        </div>
      <% }) %>
    <% } %>
  </details>
</body>
</html>
