<% if (website && website.contactPhone) { %>
  <div class="floating-contact">
    <a href="tel:<%= website.contactPhone %>" class="fc-call" aria-label="কল করুন">
      <svg viewBox="0 0 512 512" width="24" height="24" fill="#fff" aria-hidden="true">
        <path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C11.7 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-11.7 39.6-28.6l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-88-40c-16.3-7.4-35.7-2.7-46.7 11.2L303 384.6c-58.7-27.3-106.4-75-133.7-133.7l71.4-50.7c13.9-11 18.6-30.4 11.2-46.7l-40-88z"/>
      </svg>
    </a>
    <% if (whatsappNumber) { %>
      <a href="https://wa.me/<%= whatsappNumber %>" target="_blank" class="fc-whatsapp" aria-label="হোয়াটসঅ্যাপে মেসেজ করুন">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="#fff" aria-hidden="true">
          <path d="M20.463 3.488C18.217 1.24 15.231.001 12.05 0 5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.87 11.87 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413zm-8.413 18.3h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.999-3.648-.235-.374a9.86 9.86 0 01-1.51-5.264c.001-5.45 4.436-9.884 9.888-9.884 2.64.001 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.888-9.886 9.888zm5.422-7.403c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
      </a>
    <% } %>
  </div>
  <script>
    (function () {
      var fc = document.querySelector('.floating-contact');
      if (!fc) return;
      var hideTimer = null;
      window.addEventListener('scroll', function () {
        fc.classList.add('fc-hidden');
        clearTimeout(hideTimer);
        hideTimer = setTimeout(function () {
          fc.classList.remove('fc-hidden');
        }, 500);
      }, { passive: true });
    })();
  </script>
<% } %>
