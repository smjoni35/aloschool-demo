<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= student.name %> — নম্বর এডিট</title>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet">
<%- include('_style') %>
<%- include('_pwa') %>
</head>
<body>
  <div class="app-shell">
    <%- include('_sidebar') %>
    <div class="main-content">

  <div class="nav">
    <a href="/panel">🏠 হোম</a>
    <a href="/logout">🚪 লগআউট</a>
    <a href="/exams/<%= exam.key %>/results">⬅ ফলাফল</a>
  </div>

  <div class="card">
    <h1><%= student.roll ? student.roll + '. ' : '' %><%= student.name %></h1>
    <p class="sub"><%= exam.className %> — <%= exam.examName %> — এখানে যেকোনো বিষয়ের নম্বর বদলে দিন</p>

    <% if (typeof manualError !== 'undefined' && manualError && manualError.length > 0) { %>
      <div style="background:#fef2f2; border:1px solid #fecaca; border-radius:8px; padding:10px 12px; margin-bottom:16px;">
        <p style="color:#b91c1c; font-size:14px; margin:0 0 6px; font-weight:600;">⚠️ কিছু নম্বর সেভ হয়নি:</p>
        <ul style="margin:0; padding-left:18px; font-size:13px; color:#b91c1c;">
          <% manualError.forEach(e => { %>
            <li><%= e.subjectName %> — <%= e.reason %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <% if (exam.subjects.length === 0) { %>
      <p class="empty">এই পরীক্ষায় এখনো কোনো বিষয় যোগ করা হয়নি।</p>
    <% } else { %>
      <form method="POST" action="/exams/<%= exam.key %>/student/<%= student.id %>/edit-marks">
        <% exam.subjects.forEach(s => { %>
          <% const existing = marks[s.name] ?? ''; %>
          <div class="subject-input-row">
            <div class="name"><%= s.name %> <span style="color:#999; font-size:12px;">(পূর্ণমান <%= s.fullMarks %>)</span></div>
            <input
              type="number"
              step="0.01"
              name="marks[<%= s.name %>]"
              placeholder="নম্বর"
              min="0"
              max="<%= s.fullMarks %>"
              value="<%= existing %>"
            />
          </div>
        <% }) %>
        <button type="submit" class="btn btn-primary btn-block">সেভ করুন</button>
      </form>
    <% } %>
  </div>
  <%- include('_script') %>

    </div>
  </div>
</body>
</html>
